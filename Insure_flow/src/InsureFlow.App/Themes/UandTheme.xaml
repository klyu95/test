<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 노무법인 유앤 디자인시스템: Color Palette -->
    <Color x:Key="PrimaryColor">#00AEEF</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#00AEEF"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0089BF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E0F6FD"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#75787D"/>
    <SolidColorBrush x:Key="InvertedBrush" Color="#5F6368"/>
    <SolidColorBrush x:Key="SecondarySoftBrush" Color="#EEF0F2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0B8A62"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3F8F0"/>
    <SolidColorBrush x:Key="SupportBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="SupportDarkBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SupportSoftBrush" Color="#FEF3DC"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE8E8"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="NeutralCellBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- Typography: Pretendard(한글) / Inter(영문), 미설치 시 맑은 고딕 -->
    <FontFamily x:Key="UandFont">Pretendard, Inter, Malgun Gothic</FontFamily>

    <!-- Card / Divider -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18"/>
    </Style>

    <!-- Typography styles -->
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Buttons: Primary / Secondary / Outlined / Inverted -->
    <ControlTemplate x:Key="UandButtonTemplate" TargetType="Button">
        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.74"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Secondary (기본) -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource UandButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource SecondarySoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SecondarySoftBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="OutlinedBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
    </Style>
    <Style x:Key="InvertedBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource InvertedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InvertedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Input -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeutralBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox: 포인트 컬러 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource InputBorderBrush}" Background="White" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path x:Name="mark" Data="M4,10 L8,14 L16,5" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowBackground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="RowHeight" Value="34"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource NeutralBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,9"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status Chip: 정상(진행중 초록) / 확인 대상(검토중 주황) / 동명이인(주의 빨강) -->
    <DataTemplate x:Key="StatusChipTemplate">
        <Border x:Name="chip" HorizontalAlignment="Left" CornerRadius="12" Padding="9,3" Margin="6,0"
                Background="{StaticResource AccentSoftBrush}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dot" Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="txt" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentDarkBrush}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding StatusText}" Value="확인 대상">
                <Setter TargetName="chip" Property="Background" Value="{StaticResource SupportSoftBrush}"/>
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource SupportBrush}"/>
                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource SupportDarkBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusText}" Value="동명이인 확인">
                <Setter Property="Background" TargetName="chip" Value="{StaticResource DangerSoftBrush}"/>
                <Setter TargetName="dot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource DangerDarkBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
