<Window x:Class="InsureFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InsureFlow - 4대보험 공제 자동 입력" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        FontFamily="Malgun Gothic" FontSize="13" Background="#F5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <SolidColorBrush x:Key="Accent" Color="#2B5FD9"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B8C4E6"/>
                    <Setter Property="BorderBrush" Value="#B8C4E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 단계 표시줄 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="InsureFlow" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,28,0"/>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="box" Margin="0,0,6,0" Padding="10,8" CornerRadius="4" Background="#E8EAEE">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="num" Text="{Binding Number}" FontWeight="Bold" Margin="0,0,8,0" Foreground="#6B7280"/>
                                <TextBlock x:Name="ttl" Text="{Binding Title}" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#DCE6FB"/>
                                <Setter TargetName="num" Property="Foreground" Value="#2B5FD9"/>
                                <Setter TargetName="ttl" Property="Foreground" Value="#2B5FD9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#2B5FD9"/>
                                <Setter TargetName="num" Property="Foreground" Value="White"/>
                                <Setter TargetName="ttl" Property="Foreground" Value="White"/>
                                <Setter TargetName="ttl" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 본문 -->
        <Grid Grid.Row="1">
            <!-- 1단계: 파일 선택 -->
            <Grid Visibility="{Binding IsStep0, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="1. 파일 선택" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="대상 양식과 EDI 원본 3개를 선택하세요. 파일을 이 창에 끌어다 놓으면 종류를 자동으로 인식해 알맞은 칸에 넣습니다. 원본 파일은 수정하지 않으며, 결과는 새 .xls 파일로 저장됩니다."/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
                                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" Padding="6,5" Background="#FAFAFB"/>
                                            <TextBlock Text="{Binding Status}" Margin="0,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="찾아보기..." Command="{Binding BrowseCommand}" Style="{StaticResource Btn}" VerticalAlignment="Bottom" Margin="12,0,0,24"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2단계: 입력 미리보기 -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <TextBlock Text="2. 입력 미리보기" Style="{StaticResource H2}"/>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="확인 대상만 보기" IsChecked="{Binding OnlyCheck}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="값은 근로자 부담분입니다. 노란색은 확인 대상, 회색은 해당 없음(빈칸)입니다. 직원을 클릭하면 산출 근거가 오른쪽에 표시됩니다."/>
                    <TextBlock Text="{Binding Warnings}" Foreground="#B45309" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <DataGrid x:Name="PreviewGrid" Grid.Row="1" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" SelectionMode="Single" RowHeaderWidth="0" Background="White" BorderBrush="#E1E4EA"
                          HorizontalGridLinesBrush="#EEF0F3"/>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding HasCandidates, Converter={StaticResource B2V}}" Margin="0,10,0,0">
                            <TextBlock Text="동일인 선택 (주민번호는 마스킹 표시)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="이 사람으로 확정" Command="{Binding ChooseCandidateCommand}" Style="{StaticResource PrimaryBtn}" Margin="0"/>
                                <Button Content="선택 취소" Command="{Binding ClearChoiceCommand}" Style="{StaticResource Btn}" MinWidth="70"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Selected.DetailLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="확인 사유" FontWeight="SemiBold" Margin="0,10,0,4"
                                           Visibility="{Binding Selected.NeedsCheck, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding Selected.Source.Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,3"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 3단계: 확인 -->
            <ScrollViewer Visibility="{Binding IsStep2, Converter={StaticResource B2V}}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="3. 확인 — 보험별 합계 검증" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Text="원본 근로자 부담 합계 = 양식 입력 합계 + 대상 외 직원분 + 미반영분. 차이가 0이면 일치입니다."/>
                    <TextBlock Text="{Binding Summary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding Recon}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="#E1E4EA" HorizontalGridLinesBrush="#EEF0F3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="보험" Binding="{Binding Insurance}" Width="110"/>
                            <DataGridTextColumn Header="구분" Binding="{Binding Period}" Width="70"/>
                            <DataGridTextColumn Header="원본 합계" Binding="{Binding SourceTotal}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="양식 입력 합계" Binding="{Binding Entered}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="대상 외 직원분" Binding="{Binding OutOfTarget}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="미반영분" Binding="{Binding Unreflected}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOk}" Value="False"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="참고 대조 (원본 자체 합계·사업주 몫 등)" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <DataGrid ItemsSource="{Binding References}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0" Background="White" BorderBrush="#E1E4EA" HorizontalGridLinesBrush="#EEF0F3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="항목" Binding="{Binding Label}" Width="3*"/>
                            <DataGridTextColumn Header="집계값" Binding="{Binding Actual}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="원본 기준값" Binding="{Binding Expected}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding NeedsConfirm, Converter={StaticResource B2V}}" Background="#FFF8E6" BorderBrush="#F1D9A0">
                        <CheckBox IsChecked="{Binding ConfirmChecked}">
                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4단계: 저장 -->
            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource B2V}}">
                <TextBlock Text="4. 저장" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="저장할 새 .xls 파일" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseOutputCommand}" Style="{StaticResource Btn}"/>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,5"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   Text="원본 대상 양식은 그대로 두고 새 파일로 저장합니다. 같은 폴더에 '_검증보고서.xlsx'도 함께 만들어집니다."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Margin="0"/>
                            <Button Content="폴더 열기" Command="{Binding OpenFolderCommand}" Style="{StaticResource Btn}"/>
                            <Button Content="검증 보고서 열기" Command="{Binding OpenReportCommand}" Style="{StaticResource Btn}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SaveMessage}" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#15803D"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 오류 표시줄 -->
        <Border Grid.Row="2" Background="#FDECEC" BorderBrush="#F5B5B5" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="#B91C1C" TextWrapping="Wrap"/>
        </Border>

        <!-- 하단 버튼 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="처리 중..." Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       Visibility="{Binding Busy, Converter={StaticResource B2V}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="◀ 이전" Command="{Binding BackCommand}" Style="{StaticResource Btn}"/>
                <Button Content="{Binding NextText}" Command="{Binding NextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
