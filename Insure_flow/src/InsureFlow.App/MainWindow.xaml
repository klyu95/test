<Window x:Class="InsureFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InsureFlow - 4대보험 공제 자동 입력" Width="1340" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        FontFamily="{StaticResource UandFont}" FontSize="14" Foreground="{StaticResource TextBrush}"
        Background="{StaticResource NeutralBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="NumRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="Margin" Value="6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOk}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerDarkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 + 단계 표시줄 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
                <TextBlock FontSize="26" FontWeight="Bold">
                    <Run Text="Insure" Foreground="{StaticResource InvertedBrush}"/><Run Text="Flow" Foreground="{StaticResource PrimaryBrush}"/>
                </TextBlock>
                <TextBlock Text="PEOPLE · EXPERTISE · TRUST" FontSize="9.5" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" Margin="1,0,0,0"/>
            </StackPanel>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="box" Margin="0,0,8,0" Padding="12,9" CornerRadius="22" Background="White"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border x:Name="circle" Width="24" Height="24" CornerRadius="12" Background="{StaticResource NeutralCellBrush}" Margin="0,0,9,0">
                                    <TextBlock x:Name="num" Text="{Binding Number}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="ttl" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="circle" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="num" Property="Foreground" Value="White"/>
                                <Setter TargetName="ttl" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="circle" Property="Background" Value="White"/>
                                <Setter TargetName="num" Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                <Setter TargetName="ttl" Property="Foreground" Value="White"/>
                                <Setter TargetName="ttl" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 본문 -->
        <Grid Grid.Row="1">
            <!-- 1단계: 파일 선택 -->
            <Grid Visibility="{Binding IsStep0, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="파일 선택" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="대상 양식과 EDI 원본 3개를 선택하세요. 파일을 이 창에 끌어다 놓으면 종류를 자동으로 인식해 알맞은 칸에 넣습니다. 원본 파일은 수정하지 않으며, 결과는 새 .xls 파일로 저장됩니다."/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,2,0,8"/>
                                            <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True"/>
                                            <Border HorizontalAlignment="Left" CornerRadius="12" Padding="9,3" Margin="0,9,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource NeutralCellBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource SecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="찾아보기..." Command="{Binding BrowseCommand}" Style="{StaticResource Btn}"
                                                VerticalAlignment="Bottom" Margin="14,0,0,34"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2단계: 입력 미리보기 -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                    <TextBlock Text="입력 미리보기" Style="{StaticResource H2}"/>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="확인 대상만 보기" IsChecked="{Binding OnlyCheck}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Medium"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" FontSize="12.5"
                               Text="값은 근로자 부담분입니다. 노란색 칸은 확인 대상, 회색 칸은 해당 없음(빈칸)입니다. 직원을 클릭하면 산출 근거가 오른쪽에 표시됩니다."/>
                    <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource SupportDarkBrush}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasWarnings, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="1">
                    <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" SelectionMode="Single" RowHeaderWidth="0" BorderThickness="0"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Style="{StaticResource Label}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding HasCandidates, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                            <TextBlock Text="동일인 선택 (주민번호는 마스킹 표시)" Style="{StaticResource Label}" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" Margin="0,0,0,8" Padding="8,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="이 사람으로 확정" Command="{Binding ChooseCandidateCommand}" Style="{StaticResource PrimaryBtn}" Margin="0"/>
                                <Button Content="선택 취소" Command="{Binding ClearChoiceCommand}" Style="{StaticResource Btn}" MinWidth="76"/>
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Selected.DetailLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5" FontSize="13"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="확인 사유" Style="{StaticResource Label}" FontSize="13" Margin="0,12,0,5"
                                           Visibility="{Binding Selected.NeedsCheck, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding Selected.Source.Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource SupportDarkBrush}" TextWrapping="Wrap" Margin="0,0,0,3" FontSize="13"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 3단계: 확인 -->
            <ScrollViewer Visibility="{Binding IsStep2, Converter={StaticResource B2V}}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="확인 — 보험별 합계 검증" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Text="원본 근로자 부담 합계 = 양식 입력 합계 + 대상 외 직원분 + 미반영분. 차이가 0이면 일치입니다."/>
                    <TextBlock Text="{Binding Summary}" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="Medium"/>
                    <Border CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="1">
                        <DataGrid ItemsSource="{Binding Recon}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="보험" Binding="{Binding Insurance}" Width="120" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding Period}" Width="80" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="원본 합계" Binding="{Binding SourceTotal}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="양식 입력 합계" Binding="{Binding Entered}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="대상 외 직원분" Binding="{Binding OutOfTarget}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="미반영분" Binding="{Binding Unreflected}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="차이" Binding="{Binding Diff}" Width="80" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="90" ElementStyle="{StaticResource ResultText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Text="참고 대조 (원본 자체 합계 · 사업주 몫 등)" Style="{StaticResource Label}" FontWeight="Bold" Margin="0,18,0,8"/>
                    <Border CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="1">
                        <DataGrid ItemsSource="{Binding References}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="항목" Binding="{Binding Label}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="집계값" Binding="{Binding Actual}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="원본 기준값" Binding="{Binding Expected}" Width="*" ElementStyle="{StaticResource NumRight}"/>
                                <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,8" Visibility="{Binding NeedsConfirm, Converter={StaticResource B2V}}"
                            Background="{StaticResource SupportSoftBrush}" BorderBrush="#F8D79A">
                        <CheckBox IsChecked="{Binding ConfirmChecked}">
                            <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4단계: 저장 -->
            <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource B2V}}">
                <TextBlock Text="저장" Style="{StaticResource H2}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="저장할 새 .xls 파일" Style="{StaticResource Label}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseOutputCommand}" Style="{StaticResource Btn}"/>
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" FontSize="12.5"
                                   Text="원본 대상 양식은 그대로 두고 새 파일로 저장합니다. 같은 폴더에 '_검증보고서.xlsx'도 함께 만들어집니다."/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="저장" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryBtn}" Margin="0"/>
                            <Button Content="폴더 열기" Command="{Binding OpenFolderCommand}" Style="{StaticResource OutlinedBtn}"/>
                            <Button Content="검증 보고서 열기" Command="{Binding OpenReportCommand}" Style="{StaticResource OutlinedBtn}"/>
                        </StackPanel>
                        <Border Margin="0,18,0,0" CornerRadius="10" Padding="14,12" Background="{StaticResource AccentSoftBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SaveMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SaveMessage}" TextWrapping="Wrap" Foreground="{StaticResource AccentDarkBrush}" FontWeight="Medium"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 오류 표시줄 -->
        <Border Grid.Row="2" Background="{StaticResource DangerSoftBrush}" BorderBrush="#F8B4B4" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerDarkBrush}" TextWrapping="Wrap" FontWeight="Medium"/>
        </Border>

        <!-- 하단 버튼 -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Text="처리 중..." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       Visibility="{Binding Busy, Converter={StaticResource B2V}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="◀ 이전" Command="{Binding BackCommand}" Style="{StaticResource OutlinedBtn}"/>
                <Button Content="{Binding NextText}" Command="{Binding NextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
